# Optional backend runtime values. Copy to .env locally; never commit .env.
# Leave credentials empty for the free deterministic demonstration.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Alternative text provider only when AI_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=
